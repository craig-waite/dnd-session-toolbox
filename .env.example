# Deploy note: in CI (.github/workflows/deploy.yml), VITE_CLERK_PUBLISHABLE_KEY is a
# build-time var (Vite inlines it at build); MONGODB_URI, MONGODB_DB, and CLERK_SECRET_KEY
# are pushed to Cloudflare as Worker runtime secrets via `wrangler secret put` — never baked
# into wrangler.jsonc.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/
MONGODB_DB=dnd-session-toolbox

# Clerk (clerk.com) — create an application at https://dashboard.clerk.com,
# then copy the keys from the API Keys page.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Email of an existing user in your Clerk dev instance — used by e2e/dm-shell.spec.ts
# to test the signed-in app via @clerk/testing (no password needed, it mints a
# sign-in token via the Backend API). Leave blank to skip that test.
E2E_CLERK_TEST_USER_EMAIL=
