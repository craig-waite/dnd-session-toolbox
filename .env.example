# Deploy note: push to main deploys this app to the Cloudflare preview Worker
# (.github/workflows/deploy-preview.yml), push to release deploys to production
# (.github/workflows/deploy-production.yml). Each has its own GitHub secrets — production
# uses MONGODB_URI/MONGODB_DB/CLERK_SECRET_KEY/VITE_CLERK_PUBLISHABLE_KEY, preview uses the
# same names suffixed _PREVIEW — so preview never touches production data. In both cases
# VITE_CLERK_PUBLISHABLE_KEY(_PREVIEW) is a build-time var (Vite inlines it at build);
# MONGODB_URI, MONGODB_DB, and CLERK_SECRET_KEY (and their _PREVIEW counterparts) are pushed
# to Cloudflare as Worker runtime secrets via `wrangler secret put` — never baked into
# wrangler.jsonc.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/
MONGODB_DB=dnd-session-toolbox

# Clerk (clerk.com) — create an application at https://dashboard.clerk.com,
# then copy the keys from the API Keys page.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Email of an existing user in your Clerk dev instance — used by e2e/dm-shell.spec.ts
# to test the signed-in app via @clerk/testing (no password needed, it mints a
# sign-in token via the Backend API). Leave blank to skip that test.
E2E_CLERK_TEST_USER_EMAIL=
